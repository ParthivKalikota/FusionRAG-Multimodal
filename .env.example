# ═══════════════════════════════════════════════════════════════
# Multimodal RAG — Environment Configuration
# ═══════════════════════════════════════════════════════════════

# ── LLM ─────────────────────────────────────────────────────────
# "openai"  → GPT-4o via API (requires OPENAI_API_KEY)
# "ollama"  → Phi-3 Mini via Ollama (fully offline, no key needed)
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-...           # only needed when LLM_PROVIDER=openai

CLOUD_LLM_MODEL=gpt-4o          # used when LLM_PROVIDER=openai
LOCAL_LLM_MODEL=phi3            # used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# ── STT (Speech-to-Text / Whisper) ──────────────────────────────
# "local"   → openai-whisper library (runs on CPU, no key needed) ✅ recommended
# "openai"  → OpenAI Whisper API (uses OPENAI_API_KEY)
STT_PROVIDER=local

LOCAL_WHISPER_MODEL=small       # tiny | base | small | medium | large

# ── Reranker ────────────────────────────────────────────────────
# Always local cross-encoder — no API key, no config needed
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── CLIP Embedder ────────────────────────────────────────────────
# Always local — no API key, no config needed
CLIP_MODEL=openai/clip-vit-base-patch32

# ── Retrieval ────────────────────────────────────────────────────
RETRIEVAL_TOP_K=30
RERANK_TOP_N=5

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ragdb

# ── Storage ──────────────────────────────────────────────────────
STORAGE_DIR=storage/images
UPLOAD_DIR=uploads

# ═══════════════════════════════════════════════════════════════
# Default (Hybrid) Setup:
#   LLM_PROVIDER=openai  → GPT-4o for high-quality answers
#   STT_PROVIDER=local   → Whisper small, free, runs on CPU
#   Reranker             → cross-encoder, local, no API key
#   CLIP                 → local, no API key
#
# To go fully local (no internet required):
#   LLM_PROVIDER=ollama  (run: ollama pull phi3 first)
#   STT_PROVIDER=local   (already local)
# ═══════════════════════════════════════════════════════════════
